<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinFresh</AssemblyName>
    <RootNamespace>WinFresh</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>WinFresh Studio Contributors</Authors>
    <Product>WinFresh Studio</Product>
    <Description>Open-Source Windows 10/11 Performance &amp; Fresh-Install Restorer</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

</Project>
