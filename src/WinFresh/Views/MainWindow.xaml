<Window x:Class="WinFresh.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFresh Studio"
        Width="1140" Height="720"
        MinWidth="1040" MinHeight="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,11">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3" Height="18"
                                        CornerRadius="2"
                                        Background="#10B981"
                                        HorizontalAlignment="Left"
                                        Margin="-14,0,0,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141B26"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16212E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#223247"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#04120D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#11161F"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#253245"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2433"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerSmallButton" TargetType="Button">
            <Setter Property="Background" Value="#241319"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="BorderBrush" Value="#5B212A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#161D29"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E2736"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#94A3B8" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="Knob" Property="Background" Value="#04120D"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" Background="#0D121A" BorderBrush="#334155" BorderThickness="1.5">
                            <TextBlock x:Name="CheckMark" Text="✓" Foreground="#04120D" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#11161F"/>
            <Setter Property="BorderBrush" Value="#1E2736"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Border Background="#090C10" BorderBrush="#1E2736" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D1117" BorderBrush="#1E2736" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#0F2922" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" Foreground="#10B981" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WinFresh Studio" Foreground="#F1F5F9" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#132233" BorderBrush="#1F3B57" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 • ADMIN" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnQuickRestorePoint" Content="🛡️ Create Restore Point" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="QuickRestorePoint_Click"/>
                        <Button x:Name="BtnGlobalUndo" Content="↩ Undo All" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0" Click="UndoAll_Click"/>
                        <Button Content="—" Width="32" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="Minimize_Click"/>
                        <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0B0F15" BorderBrush="#1E2736" BorderThickness="0,0,1,0" CornerRadius="0,0,0,14" Padding="14,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="OPTIMIZATION SUITE" Foreground="#475569" FontSize="10.5" FontWeight="Bold" Margin="10,0,0,10"/>
                            <RadioButton x:Name="NavOverview" Content="⚡  Overview" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="NavTab_Checked" Tag="0"/>
                            <RadioButton x:Name="NavCleaner" Content="🧹  Deep Cleaner" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" Tag="1"/>
                            <RadioButton x:Name="NavStartup" Content="🚀  Startup Guard" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" Tag="2"/>
                            <RadioButton x:Name="NavTweaks" Content="⚙️  Speed Tweaks" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" Tag="3"/>
                            <RadioButton x:Name="NavRam" Content="🧠  RAM &amp; Processes" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" Tag="4"/>
                            <RadioButton x:Name="NavRepair" Content="🛡️  OS Repair &amp; Safety" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" Tag="5"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#11161F" BorderBrush="#1E2736" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="100% Reversible" Foreground="#10B981" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="All Registry edits auto-backup to undo-backup.json before applying." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="24,20">

                    <!-- TAB 0: OVERVIEW -->
                    <Grid x:Name="TabOverview" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="176" Height="176" HorizontalAlignment="Left">
                                    <Ellipse Width="168" Height="168" Stroke="#1E2736" StrokeThickness="12" Fill="Transparent"/>
                                    <Path x:Name="ScoreArcPath" Stroke="#10B981" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtFreshnessScore" Text="--" Foreground="#F1F5F9" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtFreshnessLabel" Text="Scanning..." Foreground="#10B981" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="FRESHNESS SCORE" Foreground="#64748B" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Restore That Day-One Windows Feel" Foreground="#F1F5F9" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="Safely cleans junk caches, trims idle RAM, flushes stale DNS, and applies verified non-destructive speed tweaks with automatic JSON undo backup."
                                               Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnOneClickBoost" Content="⚡ 1-Click Fresh Boost" Style="{StaticResource PrimaryButton}" Padding="22,12" FontSize="14.5" Click="OneClickBoost_Click"/>
                                        <Button x:Name="BtnRescanOverview" Content="↻ Rescan System" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="16,12" Click="RescanOverview_Click"/>
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="TxtBoostStatus" Text="System ready. Click 1-Click Fresh Boost to optimize." Foreground="#94A3B8" FontSize="12"/>
                                        <Border Grid.Row="1" Height="7" CornerRadius="3.5" Background="#1A2230" Margin="0,7,0,0">
                                            <ProgressBar x:Name="PbBoost" Minimum="0" Maximum="100" Value="0" Background="Transparent" BorderThickness="0" Foreground="#10B981"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,0">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MEMORY IN USE" Foreground="#64748B" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiRam" Text="-- / -- GB" Foreground="#F1F5F9" FontSize="20" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtKpiRamPct" Text="0% utilized" Foreground="#38BDF8" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM DRIVE FREE" Foreground="#64748B" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiDisk" Text="-- GB" Foreground="#F1F5F9" FontSize="20" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtKpiDiskSub" Text="OS Partition" Foreground="#10B981" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE PROCESSES" Foreground="#64748B" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiProcs" Text="--" Foreground="#F1F5F9" FontSize="20" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtKpiStartupSub" Text="0 startup apps" Foreground="#F59E0B" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM UPTIME" Foreground="#64748B" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtKpiUptime" Text="--" Foreground="#F1F5F9" FontSize="20" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtKpiJunkSub" Text="0 MB junk detected" Foreground="#94A3B8" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" x:Name="BoostSummaryCard" Style="{StaticResource CardBorder}" Margin="0,16,0,0" VerticalAlignment="Top" BorderBrush="#1F3B33">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✨" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtBoostSummaryTitle" Text="Live Diagnostics Active" Foreground="#10B981" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtBoostSummaryBody" Text="Telemetry refreshes every 3 seconds using native Win32 GlobalMemoryStatusEx with near-zero CPU overhead." Foreground="#94A3B8" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 1: DEEP CLEANER -->
                    <Grid x:Name="TabCleaner" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Deep Junk Cleaner" Foreground="#F1F5F9" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Scans 8 safe Windows &amp; browser cache locations. Never touches passwords, cookies, or personal files." Foreground="#94A3B8" FontSize="12.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCleanerTotal" Text="0 MB reclaimable" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button x:Name="BtnScanJunk" Content="🔍 Scan" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ScanJunk_Click"/>
                                <Button x:Name="BtnCleanJunk" Content="🧹 Clean Selected" Style="{StaticResource PrimaryButton}" Click="CleanJunk_Click"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="PbCleaner" Grid.Row="1" Height="5" Minimum="0" Maximum="100" Value="0" Background="#161D29" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CleanerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource CleanCheckBoxStyle}" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="  •  " Foreground="#475569"/>
                                                        <TextBlock Text="{Binding SafetyNote}" Foreground="#38BDF8" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SizeFormatted}" Foreground="#10B981" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FileCountFormatted}" Foreground="#64748B" FontSize="11.5" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: STARTUP GUARD -->
                    <Grid x:Name="TabStartup" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Startup Guard" Foreground="#F1F5F9" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Pausing an item safely backs it up to HKCU\Software\WinFresh\DisabledStartup — flip it back ON anytime." Foreground="#94A3B8" FontSize="12.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStartupCount" Text="0 items" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshStartup_Click"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StartupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,9" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold"/>
                                                        <Border Background="#161D29" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Location}" Foreground="#94A3B8" FontSize="10.5"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Command}" Foreground="#64748B" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#161D29" BorderBrush="#243044" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Impact}" Foreground="{Binding ImpactColorHex}" FontSize="11.5" FontWeight="SemiBold"/>
                                                </Border>

                                                <CheckBox Grid.Column="2"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Click="StartupToggle_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: SPEED TWEAKS -->
                    <Grid x:Name="TabTweaks" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Verified Speed Tweaks" Foreground="#F1F5F9" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="8 real, documented Windows optimizations. Every change is backed up automatically before applying." Foreground="#94A3B8" FontSize="12.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="↩ Undo All / Restore Defaults" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="UndoAll_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweaksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="15,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold"/>
                                                        <Border Background="#0F2922" BorderBrush="#145340" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="9,0,0,0">
                                                            <TextBlock Text="{Binding ImpactBadge}" Foreground="#10B981" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Click="TweakToggle_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 4: RAM & PROCESSES -->
                    <Grid x:Name="TabRam" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="RAM &amp; Heavy Processes" Foreground="#F1F5F9" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Reclaim idle working-set memory safely via psapi.dll EmptyWorkingSet or end runaway background apps." Foreground="#94A3B8" FontSize="12.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RefreshProcesses_Click"/>
                                <Button x:Name="BtnTrimRam" Content="⚡ Smart RAM Trim" Style="{StaticResource PrimaryButton}" Click="TrimRam_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="TxtRamBanner" Text="Memory usage: --" Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRamTrimResult" Text="Click Smart RAM Trim to safely release unused working-set pages from non-system apps." Foreground="#10B981" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProcessList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="115"/>
                                                    <ColumnDefinition Width="105"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F1F5F9" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Pid, StringFormat=PID {0}}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MemoryFormatted}" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Content="{Binding ActionLabel}"
                                                        Style="{StaticResource DangerSmallButton}"
                                                        IsEnabled="{Binding CanEndTask}"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        Click="EndProcess_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: OS REPAIR & SAFETY -->
                    <Grid x:Name="TabRepair" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="OS Repair &amp; Safety Console" Foreground="#F1F5F9" FontSize="21" FontWeight="Bold"/>
                            <TextBlock Text="Built-in native Windows maintenance tools with live terminal output streaming." Foreground="#94A3B8" FontSize="12.5" Margin="0,3,0,0"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
                            <Button x:Name="BtnRepairRestore" Content="🛡️ Restore Point" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,11" Click="RepairRestorePoint_Click"/>
                            <Button x:Name="BtnRepairTrim" Content="💿 SSD TRIM" Style="{StaticResource SecondaryButton}" Margin="3,0,3,0" Padding="8,11" Click="RepairSsdTrim_Click"/>
                            <Button x:Name="BtnRepairSfc" Content="🩺 SFC /scannow" Style="{StaticResource SecondaryButton}" Margin="3,0,3,0" Padding="8,11" Click="RepairSfc_Click"/>
                            <Button x:Name="BtnRepairDism" Content="🔧 DISM Repair" Style="{StaticResource SecondaryButton}" Margin="3,0,3,0" Padding="8,11" Click="RepairDism_Click"/>
                            <Button x:Name="BtnRepairIcons" Content="🔄 Icon Cache" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="8,11" Click="RepairIcons_Click"/>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="#06080C" BorderBrush="#1E2736" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="LIVE SYSTEM TERMINAL OUTPUT" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnCancelRepair" Content="Stop Task" Style="{StaticResource DangerSmallButton}" Margin="0,0,8,0" IsEnabled="False" Click="CancelRepair_Click"/>
                                        <Button Content="Clear Log" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Click="ClearLog_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="TxtRepairTerminal"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         Foreground="#10B981"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas, Courier New"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="[WinFresh] Ready. Select any maintenance action above to stream live output..."/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
